<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1"
	xmlns="http://xmlns.jcp.org/xml/ns/persistence"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">


	<persistence-unit name="tarefas">
		<non-jta-data-source>java:/comp/env/jdbc/tarefasDS</non-jta-data-source>


		<class>io.github.Leandro208.projetoESIG.dominio.Tarefa</class>
		<class>io.github.Leandro208.projetoESIG.dominio.Responsavel</class>
		<class>io.github.Leandro208.projetoESIG.dominio.Equipe</class>
		<class>io.github.Leandro208.projetoESIG.dominio.Usuario</class>
		<class>io.github.Leandro208.projetoESIG.dominio.RegistroAcesso</class>
		<class>io.github.Leandro208.projetoESIG.dominio.LogDB</class>

		<properties>
			<property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />
			<property name="hibernate.show_sql" value="true" />
			<!-- <property name="hibernate.format_sql" value="true" />-->
		</properties>
	</persistence-unit>
</persistence>